# ===== 部署入口（宿主机侧）=====
# 宿主机映射端口；对外访问 http://<服务器IP>:APP_PORT
APP_PORT=3000
# 数据目录：SQLite、用户工程、发布快照、模板缓存都会写在这里（务必持久化/备份）
DATA_DIR=./data
# 使用远程镜像而不在服务器上构建时填写，例如：
# ATOMS_IMAGE=ghcr.io/<owner>/<repo>:latest

# ===== AI 模型（OpenAI 兼容接口）=====
# 必填：缺失时平台可启动，但生成与对话返回 503 配置提示
OPENAI_API_KEY=
# 兼容服务需要改写，例如 https://api.deepseek.com/v1
OPENAI_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=gpt-4o
SPEC_MODEL=gpt-4o
PLAN_MODEL=gpt-4o
BUILD_MODEL=gpt-4o-mini
REPAIR_MODEL=gpt-4o

# ===== 正式发布 =====
# 平台对外源地址（含协议、不含路径），用于发布页展示线上地址；留空只显示本地地址
PUBLIC_APP_ORIGIN=

# ===== 可选调优 =====
COMMAND_TIMEOUT_MS=120000
MAX_TOOL_OUTPUT_CHARS=30000
PORT_RANGE_MIN=4000
PORT_RANGE_MAX=4999

# ===== 工程执行隔离 =====
# compose固定native后端，入口预检要求容器运行时允许非特权用户命名空间。
# 缺失时拒绝启动，不自动挂Docker socket，不关闭seccomp或启用privileged。
# 具体宿主机/运行时准备见 docs/execution-isolation.md。
CHROMIUM_PATH=/usr/bin/chromium

# ===== 平台配置 =====
# 用户项目工作区根目录（AI 读写限制在此目录内）
WORKSPACE_ROOT=/Users/pen/workspace/atoms-c/data/projects
# SQLite 数据库文件路径
DATABASE_PATH=/Users/pen/workspace/atoms-c/data/atoms.db
# 用户项目服务的端口池范围
PORT_RANGE_MIN=4000
PORT_RANGE_MAX=4999

# ===== AI 模型配置（OpenAI 兼容接口）=====
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-xxx
CHAT_MODEL=gpt-4o

# ===== 正式发布 =====
# 可选：平台实际公网源（不含路径）；留空只展示本地发布地址。
PUBLIC_APP_ORIGIN=
# 生产数据及发布快照保存在 WORKSPACE_ROOT 的同级 runtime/、releases/。
# 应用第三方环境变量：data/runtime/<projectId>/env.json，不能覆盖运行时内置变量。

# ===== 工程执行隔离 =====
# auto: macOS sandbox-exec / Linux bwrap 不可用时使用本机 Docker；无可用后端则拒绝执行。
# native: 必须具备原生隔离；docker: 必须具备Docker daemon和下列镜像。
WORKSPACE_EXECUTION_BACKEND=auto
WORKSPACE_CONTAINER_IMAGE=node:22-bookworm-slim
# 默认 preview 使用 next dev，不执行生产构建；full 才生产构建并执行业务验收。
GENERATION_VERIFICATION_MODE=preview
# full 模式浏览器验收需要安装 Chromium。Linux镜像默认 /usr/bin/chromium。
# CHROMIUM_PATH=/usr/bin/chromium

# 每阶段15分钟、模型5分钟，连续60秒无输出中止；复杂应用可调整。
GENERATION_STAGE_TIMEOUT_MS=900000
GENERATION_MODEL_TIMEOUT_MS=300000
MODEL_CHUNK_TIMEOUT_MS=60000
ACCEPTANCE_TIMEOUT_MS=300000

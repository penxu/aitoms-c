# ===== 平台配置 =====
# 用户项目工作区根目录（AI 读写限制在此目录内）
WORKSPACE_ROOT=/Users/pen/workspace/atoms-c/data/projects
# SQLite 数据库文件路径
DATABASE_PATH=/Users/pen/workspace/atoms-c/data/atoms.db
# 用户项目服务的端口池范围
PORT_RANGE_MIN=4000
PORT_RANGE_MAX=4999

# ===== AI 模型配置（OpenAI 兼容接口）=====
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-xxx
CHAT_MODEL=gpt-4o
